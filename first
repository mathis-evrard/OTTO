    <div class="max-w-5xl mx-auto">
      <h2 class="text-4xl font-bold text-[#e63946] mb-6 text-center">Schéma et code </h2>
      <ul class="list-disc pl-6 text-lg space-y-2">
        <li>  </li>
        <li>  </li>
        <li>  </li>
      </ul>
    </div>
  </section> 


    <!-- Equipe -->
    <section id="equipe" class="py-20 px-6 bg-[#1a1a1a]">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl font-bold text-[#e63946] mb-6 text-center">Equipe</h2>
        <ul class="list-disc pl-6 text-lg space-y-2">
          <li>Raphael </li>
          <li>Mathis </li>
          <li>Maxence </li>
        </ul>
      </div>
    </section> 


    <!-- Conclusion -->
    <section id="conclusion" class="py-20 px-6 max-w-5xl mx-auto">
      <h2 class="text-4xl font-bold text-[#e63946] mb-6 text-center">Conclusion</h2>
      <p class="text-lg leading-relaxed text-center">
        Ce projet a permis de mettre en pratique des compétences en conception 3D, électronique et programmation embarquée. 
        PolyBot 3D a rempli ses objectifs avec efficacité et polyvalence.
      </p>
